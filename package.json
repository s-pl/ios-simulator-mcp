{
  "name": "@s-pl/ios-simulator-mcp",
  "version": "1.2.0",
  "description": "MCP server to control the iOS Simulator (devices, apps, UI, media, environment and logs).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ios-simulator-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "prepare": "npm run build",
    "docs:tools": "npm run build && node scripts/generate-tool-docs.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "ios",
    "simulator",
    "simctl",
    "idb",
    "model-context-protocol",
    "xcode",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@grpc/proto-loader": "^0.7.15",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "author": "Samuel Ponce Luna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-pl/ios-simulator-mcp.git"
  },
  "homepage": "https://s-pl.github.io/ios-simulator-mcp/",
  "bugs": {
    "url": "https://github.com/s-pl/ios-simulator-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
