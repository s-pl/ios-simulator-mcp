{
  "name": "ios-simulator-mcp",
  "version": "1.0.0",
  "description": "MCP server to control the iOS Simulator (devices, apps, UI, media, environment and logs).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ios-simulator-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepare": "npm run build",
    "docs:tools": "npm run build && node scripts/generate-tool-docs.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "mcp",
    "ios",
    "simulator",
    "simctl",
    "idb",
    "model-context-protocol",
    "xcode",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "author": "Samuel Ponce Luna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-pl/ios-simulator-mcp.git"
  },
  "homepage": "https://s-pl.github.io/ios-simulator-mcp/",
  "bugs": {
    "url": "https://github.com/s-pl/ios-simulator-mcp/issues"
  }
}
